# PitWall — environment variables
# Copy this file to .env and fill in real values.
# Never commit .env to version control.

# Groq API key (free tier — llama-3.1-8b-instant)
GROQ_API_KEY=your_groq_api_key_here

# HuggingFace Hub token (for pushing/pulling LoRA adapter)
HF_TOKEN=your_huggingface_token_here

# HuggingFace repo where the trained adapter will be stored
HF_REPO_ID=your_username/pitwall-llama-3.2-3b-lora

# Local Qwen 2.5 3B + PEFT (evaluation and INFERENCE_BACKEND=local_qwen)
# PITWALL_INFERENCE_BACKEND=local_qwen
# PITWALL_QWEN_BASE_MODEL_PATH=M:\models\Qwen2.5-3B-Instruct
# PITWALL_QWEN_ADAPTER_PATH=M:\models\your-adapter-folder
# PITWALL_QWEN_LOAD_IN_4BIT=1
# PITWALL_QWEN_DTYPE=auto

# Flask secret key (any random string, used for session cookies)
FLASK_SECRET_KEY=change_me_to_a_random_secret
